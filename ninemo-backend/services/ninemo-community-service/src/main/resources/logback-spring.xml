<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="service"/>

  <!-- Dev: colored text with correlationId in pattern -->
  <springProfile name="!prod,!staging">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [cid:%X{correlationId:-—}] - %msg%n</pattern>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
  </springProfile>

  <!-- Prod/staging: JSON (ELK/Loki-ready) -->
  <springProfile name="prod,staging">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"${SERVICE_NAME}"}</customFields>
        <fieldNames><timestamp>timestamp</timestamp><version>[ignore]</version></fieldNames>
        <includeMdcKeyName>correlationId</includeMdcKeyName>
        <includeMdcKeyName>traceId</includeMdcKeyName>
        <includeMdcKeyName>spanId</includeMdcKeyName>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="JSON"/></root>
  </springProfile>
</configuration>